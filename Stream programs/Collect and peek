import java.util.stream.*;

class Main {
    public static void main(String[] args) {
        Stream.iterate(1, x ->x+1).limit(10)
      .peek(n -> System.out.println("Before: " + n))
      .map(n -> n * 2)
      .peek(n -> System.out.println("After: " + n))
      .collect(Collectors.toList());
      
    }
}
