import java.util.*;
import java.util.stream.*;

class Main {
    static int no ;
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter total number of objects : ");
        no = sc.nextInt();
        List<Student> stu = new ArrayList<>();
        crete(stu, 1);
        
        System.out.println("All Students");
        stu.forEach(System.out::println);
        
        Stream<Student> res = stu.stream()
                            .filter(s -> s.getMark()>70)
                            .sorted(Comparator.comparingInt(Student::getMark).reversed());
        
        System.out.println("RESULT");
        res.forEach(System.out::println);
    }
    static void crete(List<Student> ar, int n ){
        if(n > no)
        return;
        int mark = (int)(Math.random()*100 +1);
        ar.add(new Student(n, "Stu" +n , mark ));
        crete(ar, n+1);
    }
}
class Student{
    int id;
    String name;
    int marks;
    Student(int id , String name, int marks){
        this.id = id;
        this.name = name;
        this.marks = marks;
    }
    int getMark(){
        return marks;
    }
    
    @Override
    public String toString(){
        return "id = " + id + ", Name = " + name  + ", Mark = " + marks;
    }
}
