import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a no : ");
        int no = sc.nextInt();
        System.out.println(rev(no,0));
        
        sc.close();
    }
    static int rev(int num, int start){
        if(num ==0)
        return start;
        
        return rev(num /10,start*10+num%10);
    }
}
