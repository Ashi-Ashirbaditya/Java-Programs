class Main {
    public static void main(String[] args) {
        int arr[] = {2, 2, 1, 1, 2, 2, 2};
        int n = arr.length;
        boolean visited[]  = new boolean[n];
        for(int i= 0; i < n; i++ ){
            if(!visited[i]){
                int count = 1;
                for(int j = i+1; j < n; j++){
                    if(arr[i] == arr[j])
                    {
                        count++;
                        visited[j] = true;
                    }
            }
            if(count > n/2){
              System.out.println(arr[i]);
              break;  
              }
            }   
        }
    }
}
