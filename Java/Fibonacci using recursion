import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number : ");
        int no = sc.nextInt();
        for(int i = 0; i < no; i++)
        System.out.println(fib(i));
        
        sc.close();
    }
    static int fib(int num){
        if(num ==0)
        return 0;
        if(num ==1)
        return 1;
        return fib(num-1) + fib(num- 2);
    }
}
