class Main {
    public static void main(String[] args) {

        int arr[] = {52, 52, 95, 41, 89, 5, 3, 78};

        for(int i = 0; i < arr.length; i++){
            for(int j = i + 1; j < arr.length; j++){
                if(arr[i] > arr[j]) {
                    swap(arr, i, j);
                }
            }
        }

        for(int i : arr)
            System.out.print(i + " ");
    }

    static void swap(int arr[], int i, int j){
        int temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
    }
}
