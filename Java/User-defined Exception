class MyException extends Exception{
    public MyException(String msg){
        super(msg);
    }
}

class Main {
    public static void main(String[] args) {
        try{
        throw new MyException("My exception");}
        catch(MyException e){
        System.out.println(e);
        System.out.println(e.getMessage());
        e.printStackTrace();
        }
    }
}
