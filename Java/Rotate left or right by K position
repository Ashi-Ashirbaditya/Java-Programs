import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter length of the array : ");
        int len = sc.nextInt();
        int arr[] = new int[len];
        System.out.println("Enter elements in the array:");
        for(int i =0; i < len; i++){
            arr[i]= sc.nextInt();
        }
        System.out.print("Enter position for reverse the array : ");
        int pos = sc.nextInt();
        
        pos = pos%len;
        //Right Rotation
        rever(arr, 0, len-1);
        rever(arr, 0, pos -1);
        rever(arr,pos , len-1);
        
        //Left Rotation
        /*reverse(arr, 0, pos - 1);
        reverse(arr, pos, len - 1);
        reverse(arr, 0, len - 1);*/

        System.out.println("Reversed array:");
        for(int i : arr){
           System.out.println(i);
        }
        sc.close();
    }
    static void rever(int arr[], int start, int end){
        while(start < end){
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;
            start++;
            end--;
        }
    }
}
