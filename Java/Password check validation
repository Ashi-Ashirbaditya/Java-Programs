import java.util.*;

class Solution {
    public static void checkPassword(String str) {
        int n = str.length();
        
        //First character must not be a digit
        if (Character.isDigit(str.charAt(0))) {
            System.out.println("Starting character must not be a number");
            return;
        }
        //Minimum length
        if (n <= 4) {
            System.out.println("Length must be greater than 4 characters.");
            return;
        }
        //No space or slash
        for (int i = 0; i < n; i++) {
            if (str.charAt(i) == ' ' || str.charAt(i) == '/') {
                System.out.println("Password must not contain space or slash (/).");
                return;
            }
        }
        //Must have at least one digit and one uppercase
        boolean hasDigit = false, hasUpper = false;

        for (int i = 0; i < n; i++) {
            char ch = str.charAt(i);

            if (Character.isUpperCase(ch))
                hasUpper = true;

            if (Character.isDigit(ch))
                hasDigit = true;
        
        }
        if (!hasDigit || !hasUpper) {
            System.out.println("Password must contain at least one digit and one uppercase letter.");
            return;
        }
        // If all validations pass
        System.out.println("Successful");
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        System.out.print("Enter password : ");
        String str = sc.next();
        checkPassword(str);

        sc.close();
    }
}
