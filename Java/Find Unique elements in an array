import java.util.ArrayList;

class Main {
    public static void main(String[] args) {
        int arr[] = {1, 2, 2, 3, 4, 4};
        var res = new ArrayList<Integer>();
        for(int i = 0; i < arr.length; i++){
            if(arr[i] != -1){
                int count = 1;
                for(int j = i+1; j < arr.length; j++){
                    if(arr[i] == arr[j]){
                        count++;
                        arr[j] = -1;
                    }
                }
                if(count == 1)
                res.add(arr[i]);
            }
        }
    System.out.println(res);
    }
}
