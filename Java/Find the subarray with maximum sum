class Main {
    public static void main(String[] args) {
        int arr[] = {-2,1,-3,4,-1,2,1,-5,4};
        int sum = 6;

        int end = arr.length;
        
        for(int i = 0; i < end; i++){
            int current_sum = 0;
            
            for(int j = i; j < end; j++){
                current_sum += arr[j];
                
            if(current_sum == sum){
                for(int k = i; k <= j;k++){
                    System.out.println(arr[k]);
                }
                return;
            }
            }
        }
    }
}
