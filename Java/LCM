import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number1 : ");
        int num1 = sc.nextInt();
        System.out.print("Enter number2 : ");
        int num2 = sc.nextInt();
        int a = num1;
        int b = num2;
        while(num2 != 0){
            int temp =num2;
            num2 = num1 % num2;
            num1 = temp;
            
        }
        int lcm = (a * b)/num1;
        
        System.out.println(lcm);
        sc.close();
    }
}
