class Main {
    public static void main(String[] args) {
        int arr[] = {1, 2, 2, 3, 1};
        boolean visit[] = new boolean[arr.length];
        for(int i = 0; i < arr.length; i++){
            if(!visit[i])
            {
                int count = 1;
                for(int j = i +1; j < arr.length; j++){
                    if(arr[i] == arr[j]){
                        count++;
                        visit[j] = true;
                    }
                }
                System.out.println(arr[i] + " = " + count);
            }
        }
    }
}
