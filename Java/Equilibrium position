class Main {
    public static void main(String[] args) {
        int[] arr = {1, 2, 5, 1, 1, 1};
        int totalSum = 0;
        for (int num : arr) {
            totalSum += num;
        }
        int leftSum = 0;
        for (int i = 0; i < arr.length; i++) {
            int rightSum = totalSum - leftSum - arr[i];

            if (leftSum == rightSum) {
                System.out.println("Equilibrium index: " + i);
                return;
            }
            leftSum += arr[i];
        }
        System.out.println("No equilibrium index found");
    }
}
