import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number : ");
        int no = sc.nextInt();
        System.out.println(sumof(no));
        
        sc.close();
    }
    static int sumof(int num){
        if(num ==0)
        return 0;

        return (num %10) + sumof(num/10);
    }
}
