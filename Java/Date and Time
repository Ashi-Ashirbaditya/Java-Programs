import java.time.Month;
import java.time.LocalDateTime;

class Main {
    public static void main(String[] args) {
  
       LocalDateTime dt = LocalDateTime.parse("2025-12-01T03:45:45");

        int day = dt.getDayOfMonth();
        Month month = dt.getMonth();
        int year = dt.getYear();
        String dayname = dt.getDayOfWeek().name();
        
        System.out.println("Day: " + day);
        System.out.println("Month: " + month);
        System.out.println("Year: " + year);
        System.out.println("Day Name: " + dayname);
        
        int hour = dt.getHour();
        int minute = dt.getMinute();
        int second = dt.getSecond();
        
         // Convert 24-hour to AM/PM
        String ampm = (hour >= 12) ? "PM" : "AM";
        // Convert hour to 12-hour format
        int hour12 = (hour % 12 == 0) ? 12 : (hour % 12);

        System.out.println("Hour (24h): " + hour);
        System.out.println("Hour (12h): " + hour12);
        System.out.println("Minutes: " + minute);
        System.out.println("Seconds: " + second);
        System.out.println("AM/PM: " + ampm);
    }
}
