class Main {
    public static void main(String[] args) {
        Parent obj1 = new Child();
        Child obj2 = new Child();
        obj1.par();
        obj2.hel();
        obj2.par();
    }
}
class Parent{
    void par(){
        System.out.println("Hello parent");
    }
}
class Child extends Parent{
    void hel(){
        System.out.println("Hello Child");
    }
}
