import java.util.Scanner;

class Main {

    private static final String[] below20 = {
            "", "One", "Two", "Three", "Four", "Five", "Six", "Seven",
            "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen",
            "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"
    };

    private static final String[] tens = {
            "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty",
            "Seventy", "Eighty", "Ninety"
    };

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        long num;

        try {
            num = sc.nextLong();
        } catch (Exception e) {
            System.out.println("Enter a valid integer!");
            return;
        } finally {
            sc.close();
        }

        if (num == 0) {
            System.out.println("Zero");
            return;
        }

        System.out.println(numberToWords(num));
    }

    static String numberToWords(long num) {
        if (num < 0)
            return "Minus " + numberToWords(-num);

        return convert(num).trim();
    }

    static String convert(long num) {
        if (num == 0) return "";

        if (num < 20)
            return below20[(int) num] + " ";

        if (num < 100)
            return tens[(int) (num / 10)] + " " + convert(num % 10);

        if (num < 1000)
            return below20[(int) (num / 100)] + " Hundred " + convert(num % 100);

        if (num < 1_000_00)   
            return convert(num / 1000) + "Thousand " + convert(num % 1000);

        if (num < 1_00_00_000)
            return convert(num / 100000) + "Lakh " + convert(num % 100000);

        if (num < 1_00_00_00_000L)
            return convert(num / 10000000) + "Crore " + convert(num % 10000000);

        if (num < 1_000_000_000_000L)
            return convert(num / 1_000_000_000) + "Billion " + convert(num % 1_000_000_000);

        return convert(num / 1_000_000_000_000L) + "Trillion " + convert(num % 1_000_000_000_000L);
    }
}
