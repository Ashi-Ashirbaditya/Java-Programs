import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter length of the array : ");
        int len = sc.nextInt();
        int arr[] = new int[len];
        int start = 0;
        int end = len-1;
        System.out.println("Enter elements in the array:");
        for(int i =0; i < len; i++){
            arr[i]= sc.nextInt();
        }
        rever(arr,start ,end);

        for(int i : arr){
           System.out.println(i);
        }
        sc.close();
    }
    static void rever(int arr[], int start, int end){
        while(start < end){
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;
            start++;
            end--;
        }
        System.out.println("Reversed array:");
    }
}
